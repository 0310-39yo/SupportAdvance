<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogLevel="${when:when='${var:environment}'=='Release':inner=Error:else=Trace}"
      internalLogFile="C:/MeikikouApps/${var:solutionName}/${var:folderName}/${var:projectName}/Logs/${var:environment}/nlog-internal_${date:format=yyyyMMdd_HHmmss}.log"
      internalLogToConsole="${when:when='${var:environment}'=='Release':inner=false:else=true}">
  <!-- GDC から取得する値を変数化 -->
  <variable name="solutionName" value="${gdc:SolutionName}" />
  <variable name="folderName" value="${gdc:FolderName}" />
  <variable name="projectName" value="${gdc:ProjectName}" />
  <variable name="environment" value="${gdc:Environment}" />
  <!-- 環境に応じて最小ログレベルを切替（Release→Info / それ以外→Trace） -->
  <variable name="minLevel" value="${when:when='${var:environment}'=='Release':inner=Info:else=Trace}" />

  <targets>
    <!-- Console 出力（最低限の情報） -->
    <target xsi:type="Console" name="console"
            layout="■NLog:[${date}][${uppercase:${level:padding=-5}}] ${gdc:item=CorrelationId}|${message}${onexception:${newline}${exception:format=Message,Type}}" />
    <!-- Debugger 出力 -->
    <target xsi:type="Debugger" name="debugger"
            layout="●NLog:[${date}][${uppercase:${level:padding=-5}}] ${gdc:item=CorrelationId}|${message}${onexception:${newline}${exception:format=Message,Type}}" />
    <!-- File 出力（日次アーカイブ） -->
    <target xsi:type="File" name="file"
            fileName="C:/MeikikouApps/${var:solutionName}/${var:folderName}/${var:projectName}/Logs/${var:environment}/current.log"
            archiveFileName="C:/MeikikouApps/${var:solutionName}/${var:folderName}/${var:projectName}/Logs/${var:environment}/Archives/${shortdate}.log"
            archiveEvery="Day" archiveNumbering="Date" maxArchiveFiles="30"
            createDirs="true"
            layout="[${longdate}][${uppercase:${level:padding=-5}}] ${gdc:item=CorrelationId}|${message}${onexception:${newline}${exception:format=Message,Type,ToString}}" />
    <!-- 構造化ログ (JSON) -->
    <target xsi:type="File" name="file-json"
            fileName="C:/MeikikouApps/${var:solutionName}/${var:folderName}/${var:projectName}/Logs/${var:environment}/structured_${shortdate}.json"
            archiveFileName="C:/MeikikouApps/${var:solutionName}/${var:folderName}/${var:projectName}/Logs/${var:environment}/Archives/structured_${shortdate}.json"
            archiveEvery="Day" archiveNumbering="Date" maxArchiveFiles="30"
            createDirs="true"
            layout="{&quot;timestamp&quot;:&quot;${date:format=o}&quot;,&quot;level&quot;:&quot;${level}&quot;,&quot;logger&quot;:&quot;${logger}&quot;,&quot;correlationId&quot;:&quot;${gdc:item=CorrelationId}&quot;,&quot;message&quot;:${json-encode:${message}},&quot;exception&quot;:${json-encode:${exception:format=ToString}}}" />
    <!-- 詳細スタックトレース（Error 以上専用） -->
    <target xsi:type="File" name="file-detail"
            fileName="C:/MeikikouApps/${var:solutionName}/${var:folderName}/${var:projectName}/Logs/${var:environment}/errors.log"
            archiveFileName="C:/MeikikouApps/${var:solutionName}/${var:folderName}/${var:projectName}/Logs/${var:environment}/Archives/errors_${shortdate}.log"
            archiveEvery="Day" archiveNumbering="Date" maxArchiveFiles="60"
            createDirs="true"
            layout="[${longdate}][${uppercase:${level:padding=-5}}] ${gdc:item=CorrelationId}|${message}${onexception:${newline}${exception:format=Message,Type,ToString}${newline}${stacktrace}}" />
  </targets>

  <rules> 
      <!-- Error 以上は詳細ターゲットに送る（final で後続ルールを打ち切り） -->
      <logger name="*" minlevel="Error" writeTo="file-detail" final="true" />
      <!-- フレームワークログを全レベルで除外（minLevel="Trace"で全ログをキャッチ） -->
      <logger name="Microsoft.*" minLevel="Trace" writeTo="" final="true" />    
      <!-- 環境別一般ログ（Trace/Info～）と構造化JSON -->
      <logger name="*" minlevel="${var:minLevel}" writeTo="console,debugger,file,file-json" />
  </rules>
</nlog>
