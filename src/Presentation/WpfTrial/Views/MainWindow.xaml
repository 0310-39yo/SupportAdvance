<syncfusion:SfChromelessWindow
    x:Class="SupportAdvance.Presentation.WpfTrial.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:navigationDrawer="clr-namespace:Syncfusion.UI.Xaml.NavigationDrawer;assembly=Syncfusion.SfNavigationDrawer.WPF"
    Title="MainWindow"
    Width="1200"
    Height="800">

    <Grid>

        <!-- 行：Ribbon / Main / StatusBar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 列：NavigationPane / Splitter / TabbedWindow -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ribbon（Tools系） -->
        <syncfusion:Ribbon Grid.Row="0" Grid.ColumnSpan="3">
            <syncfusion:RibbonTab Caption="Home">
                <syncfusion:RibbonBar Header="File">
                    <syncfusion:RibbonButton Label="Save"
                                             Command="{Binding SaveCommand}"/>
                </syncfusion:RibbonBar>
            </syncfusion:RibbonTab>
        </syncfusion:Ribbon>

        <!-- NavigationPane（SfNavigationDrawer / モダン系） -->
        <!-- NavigationItem の階層はコードビハインドで構築する（XAML でネストした Items を
             直接パースすると、テンプレート未適用の状態で CollectionChanged が発火し
             NullReferenceException になるため） -->
        <navigationDrawer:SfNavigationDrawer Grid.Row="1" Grid.Column="0"
                             x:Name="NavigationPane"
                             DisplayMode="Expanded"
                             IsToggleButtonVisible="False">

            <navigationDrawer:SfNavigationDrawer.ContentView>
                <navigationDrawer:NavigationItemsView x:Name="NavigationItemsHost"/>
            </navigationDrawer:SfNavigationDrawer.ContentView>

        </navigationDrawer:SfNavigationDrawer>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="5"
                      ResizeBehavior="PreviousAndNext"
                      Background="#DDD"/>

        <!-- TabbedWindow（SfTabControl / モダン系） -->
        <syncfusion:SfTabControl Grid.Row="1" Grid.Column="2"
                                  x:Name="MainTabs"
                                  AllowDragDrop="True"/>

        <!-- StatusBar（Tools系） -->
        <syncfusion:RibbonStatusBar Grid.Row="2" Grid.ColumnSpan="3">
            <TextBlock Text="Ready"/>
        </syncfusion:RibbonStatusBar>

    </Grid>
</syncfusion:SfChromelessWindow>
