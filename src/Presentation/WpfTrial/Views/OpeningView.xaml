<UserControl x:Class="SupportAdvance.Presentation.WpfTrial.Views.OpeningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SupportAdvance.Presentation.Shared.ViewModels;assembly=Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OpeningViewModel}"
             d:DesignHeight="400" d:DesignWidth="600">
    <!-- オープニング画面：起動後、ナビゲーションが選ばれるまで表示する。
         右下に製品名、その下にアプリケーションの名前を表示する（将来、お知らせなどの通知もここに表示する予定） -->
    <Grid Background="White">
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,32,28">
            <TextBlock Text="{Binding ProductName}"
                       FontSize="36"
                       FontWeight="SemiBold"
                       Foreground="#FF444444"
                       HorizontalAlignment="Right" />
            <TextBlock Text="{Binding ApplicationName}"
                       FontSize="20"
                       Foreground="#FF888888"
                       HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</UserControl>
