<UserControl x:Class="SupportAdvance.Presentation.WpfTrial.Views.Form1View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SupportAdvance.Presentation.WpfTrial.Views"
        xmlns:input="clr-namespace:Syncfusion.Windows.Controls.Input;assembly=Syncfusion.SfInput.WPF"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:vm="clr-namespace:SupportAdvance.Presentation.Shared.ViewModels;assembly=Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:Form1ViewModel}"
        d:DesignHeight="380" d:DesignWidth="484">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <syncfusion:ButtonAdv Grid.Row="0"
                Label="テストボタン"
                HorizontalAlignment="Left"
                Width="125"
                SizeMode="Normal"
                IconWidth="0"
                IconHeight="0"
                FontFamily="Yu Gothic UI"
                FontSize="18"
                Command="{Binding ExecuteSampleUseCaseCommand}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <input:SfTextBoxExt Width="100"
                     VerticalContentAlignment="Center"
                     FontFamily="Yu Gothic UI"
                     FontSize="18"
                     Text="{Binding BizIdSearchInput, UpdateSourceTrigger=PropertyChanged}" />
            <syncfusion:ButtonAdv Label="検索"
                    Width="96"
                    Margin="8,0,0,0"
                    SizeMode="Normal"
                    IconWidth="0"
                    IconHeight="0"
                    FontFamily="Yu Gothic UI"
                    FontSize="18"
                    Command="{Binding SearchEmployeeByBizIdCommand}" />
            <TextBlock Text="{Binding EmployeeFullName}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding DepartmentNames}"
                   Margin="0,16,0,0" />
    </Grid>
</UserControl>
