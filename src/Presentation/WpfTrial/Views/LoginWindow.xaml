<Window x:Class="SupportAdvance.Presentation.WpfTrial.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:SupportAdvance.Presentation.WpfTrial.Behaviors"
        xmlns:converters="clr-namespace:SupportAdvance.Presentation.WpfTrial.Converters"
        xmlns:input="clr-namespace:Syncfusion.Windows.Controls.Input;assembly=Syncfusion.SfInput.WPF"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        mc:Ignorable="d"
        Title="ログイン" Height="220" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Yu Gothic UI"
        FontSize="14"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Office2019White}">
    <Window.Resources>
        <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ログインID:" VerticalAlignment="Center" />
        <input:SfTextBoxExt Grid.Row="0" Grid.Column="1"
                 Margin="0,4"
                 VerticalContentAlignment="Center"
                 FontSize="18"
                 Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsNotLoading}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="パスワード:" VerticalAlignment="Center" />
        <PasswordBox Grid.Row="1" Grid.Column="1"
                     x:Name="PasswordBoxControl"
                     Margin="0,4,0,4"
                     VerticalContentAlignment="Center"
                     FontSize="18"
                     behaviors:PasswordBoxAssistant.Attach="True"
                     behaviors:PasswordBoxAssistant.BoundPassword="{Binding Password, Mode=TwoWay}"
                     IsEnabled="{Binding IsNotLoading}" />

        <TextBlock Grid.Row="2" Grid.Column="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringEmptyToVisibilityConverter}}" />

        <StackPanel Grid.Row="4" Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <syncfusion:ButtonAdv Label="ログイン"
                    Width="100"
                    Height="30"
                    SizeMode="Normal"
                    IconWidth="0"
                    IconHeight="0"
                    FontSize="18"
                    IsDefault="True"
                    IsEnabled="{Binding IsNotLoading}"
                    Command="{Binding LoginCommand}" />
            <syncfusion:ButtonAdv Label="キャンセル"
                    Width="100"
                    Height="30"
                    Margin="8,0,0,0"
                    SizeMode="Normal"
                    IconWidth="0"
                    IconHeight="0"
                    FontSize="18"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
