<Application x:Class="SupportAdvance.Presentation.WpfTrial.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SupportAdvance.Presentation.WpfTrial"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <Application.Resources>
        <!-- Yu Gothic UI フォント設定 - Implicit Style（すべての Window に自動適用） -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- MainWindow は SfChromelessWindow を継承しているため、Window 向けの
             暗黙的スタイルが適用されない。SfChromelessWindow にも同じ設定を適用する -->
        <Style TargetType="syncfusion:SfChromelessWindow">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Application.Resources>
</Application>
