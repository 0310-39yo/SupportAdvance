<Application x:Class="SupportAdvance.Presentation.WpfTrial.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SupportAdvance.Presentation.WpfTrial"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <Application.Resources>
        <!-- Yu Gothic UI フォント設定 - Window 依存関係プロパティをオーバーライドするための基本スタイル -->
        <Style x:Key="DefaultWindowStyle" TargetType="Window">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Application.Resources>
</Application>
