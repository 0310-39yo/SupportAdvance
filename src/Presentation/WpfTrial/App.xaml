<Application x:Class="SupportAdvance.Presentation.WpfTrial.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SupportAdvance.Presentation.WpfTrial"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf">
    <Application.Resources>
        <!-- Yu Gothic UI フォント設定 - Window 依存関係プロパティをオーバーライドするための基本スタイル -->
        <Style x:Key="DefaultWindowStyle" TargetType="Window">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- Syncfusion コントロール用のフォント設定 -->
        <Style TargetType="syncfusion:ButtonAdv">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Application.Resources>
</Application>
