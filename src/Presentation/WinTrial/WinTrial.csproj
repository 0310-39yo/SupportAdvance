<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\..\configs\AppSettings\appsettings.Debug.json" Link="configs\appsettings.Debug.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\configs\AppSettings\appsettings.json" Link="configs\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\configs\AppSettings\appsettings.Release.json" Link="configs\appsettings.Release.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- アイコンフォント（実体は Presentation.Shared の 1 ファイル。ここでは埋め込みリソースとしてリンクする） -->
    <EmbeddedResource Include="..\Shared\Assets\Fonts\FluentSystemIcons-Resizable.ttf" Link="Assets\Fonts\FluentSystemIcons-Resizable.ttf" LogicalName="FluentSystemIcons-Resizable.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\configs\NLog\NLog.config" Link="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Syncfusion.Core.WinForms" Version="34.2.9" />
    <PackageReference Include="Syncfusion.Office2019Theme.WinForms" Version="34.2.9" />
    <PackageReference Include="Syncfusion.SfInput.WinForms" Version="34.2.9" />
    <PackageReference Include="Syncfusion.Tools.Windows" Version="34.2.9" />
    <PackageReference Include="Syncfusion.Shared.Base" Version="34.2.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Contexts\Department\Department.Application\Department.Application.csproj" />
    <ProjectReference Include="..\..\Contexts\Department\Department.Infrastructure\Department.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\Employee\Employee.Application\Employee.Application.csproj" />
    <ProjectReference Include="..\..\Contexts\Employee\Employee.Infrastructure\Employee.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\Authentication\Authentication.Application\Authentication.Application.csproj" />
    <ProjectReference Include="..\..\Contexts\Authentication\Authentication.Infrastructure\Authentication.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\IntegrationPrototype\IntegrationPrototype.Application\IntegrationPrototype.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\..\SharedKernel\SharedKernel.csproj" />
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Intrinsic.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>